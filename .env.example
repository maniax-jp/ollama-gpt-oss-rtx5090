# Ollama Environment Configuration
# Copy this file to .env and adjust as needed

# Ollama Host Configuration
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_ORIGINS=*

# GPU Configuration
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Performance Tuning for RTX 5090
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1

# Memory Configuration (in MB)
# Adjust based on your VRAM availability (RTX 5090 has 32GB)
OLLAMA_GPU_OVERHEAD=2048

# Logging
OLLAMA_DEBUG=false

# Optional: Specify GPU device ID (default: 0)
# GPU_DEVICE_ID=0
